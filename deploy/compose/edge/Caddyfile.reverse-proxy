{
	admin off
	auto_https off
}

import /etc/caddy/storage-cors.caddy

# No access logs. Only the explicitly configured remote proxy reaches these
# auxiliary fixture listeners; the application proxy connects directly to web.
(periapsis_external_proxy_only) {
	@local_health {
		method GET
		path /health/live
		remote_ip 127.0.0.1 ::1
	}
	@untrusted_peer not remote_ip {$PERIAPSIS_CADDY_TRUSTED_PROXY_CIDRS}
	route {
		respond @local_health "ok" 200
		respond @untrusted_peer "" 403
	}
}

http://:{$PERIAPSIS_IDP_PORT:18090} {
	import periapsis_external_proxy_only
	reverse_proxy http://identity-provider:8080 {
		# The admitted external peer terminates the required public HTTPS hop.
		header_up X-Forwarded-Proto https
	}
}

http://:{$PERIAPSIS_MINIO_API_PORT:19000} {
	import periapsis_external_proxy_only
	import periapsis_storage_cors {$PERIAPSIS_PUBLIC_URL}
}
