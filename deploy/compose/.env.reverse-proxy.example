# Explicit alternative to the local TLS edge. Start from .env.example for the
# 15 private file-backed secrets, then apply these non-secret site values.
# Leave all three PERIAPSIS_DEV_TLS_*_FILE entries empty in this mode.
# Replace documentation IPs/domains with your dedicated host and remote proxy.
PERIAPSIS_HTTP_BIND_ADDRESS=192.0.2.20
PERIAPSIS_HTTP_PORT=8080
PERIAPSIS_PUBLIC_URL=https://incidents.example.com
# Exact source addresses the containers observe from the external TLS proxy.
# Never use a universal CIDR or a whole LAN merely to make a probe succeed.
PERIAPSIS_WEB_TRUSTED_PROXY_CIDRS=192.0.2.10/32

# The proxy must publish these HTTPS origins and forward to the auxiliary edge
# on this host's HTTP ports. MinIO and Keycloak remain compatibility/test targets.
PERIAPSIS_S3_PUBLIC_ENDPOINT=https://storage.example.com
PERIAPSIS_IDP_PUBLIC_URL=https://identity.example.com
PERIAPSIS_IDP_PORT=18090
PERIAPSIS_MINIO_API_PORT=19000

# If the IdP proxy resolves to a private IP, explicitly admit only that HTTPS
# destination as well as any existing required private identity targets.
# Example only; do not copy an unrelated private network into the allowlist.
PERIAPSIS_FEDERATED_PRIVATE_EGRESS_CIDRS=192.0.2.10/32,172.30.241.0/28
PERIAPSIS_FEDERATED_HTTPS_PORTS=443
