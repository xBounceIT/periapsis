dn: olcDatabase={-1}frontend,cn=config
objectClass: olcDatabaseConfig
objectClass: olcFrontendConfig
olcDatabase: {-1}frontend
olcAccess: {0}to dn.base="" by users read by * none
olcAccess: {1}to * by * none

dn: olcDatabase={0}config,cn=config
objectClass: olcDatabaseConfig
olcDatabase: {0}config
olcAccess: {0}to * by * none

dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcDbDirectory: /var/lib/periapsis-ldap/data
olcDbMaxSize: 1073741824
olcSuffix: DC=periapsis,DC=test
olcRootDN: uid=admin,DC=periapsis,DC=test
olcAccess: {0}to attrs=userPassword by self write by anonymous auth by * none
olcAccess: {1}to * by users read by * none
olcDbIndex: objectClass eq
olcDbIndex: uid,cn,member eq

