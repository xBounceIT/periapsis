{
  "realm": "periapsis-test",
  "displayName": "Periapsis authentication test",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "config": {
          "priority": ["100"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "keySize": ["2048"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "periapsis-oidc",
      "name": "Periapsis OIDC PKCE test client",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${PERIAPSIS_PUBLIC_URL}/*"],
      "webOrigins": ["${PERIAPSIS_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PERIAPSIS_PUBLIC_URL}/*"
      },
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"]
    },
    {
      "clientId": "periapsis-saml",
      "name": "Periapsis SAML test service provider",
      "protocol": "saml",
      "publicClient": true,
      "enabled": true,
      "redirectUris": ["${PERIAPSIS_PUBLIC_URL}/*"],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "username",
        "saml.server.signature": "true"
      }
    }
  ]
}
