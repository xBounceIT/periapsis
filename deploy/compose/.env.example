# Copy these entries into the repository-root .env used by the Makefile.
# Generate independent values with at least 128 bits of entropy. Lowercase hex keeps
# the local-development database URLs unambiguous without committing credentials.
# New absolute directory outside the checkout; its parent must already exist.
# Prepare once with: node scripts/deploy/prepare-compose-secrets.mjs --env-file .env
PERIAPSIS_COMPOSE_SECRETS_DIR=
PERIAPSIS_POSTGRES_PASSWORD=
PERIAPSIS_API_DATABASE_PASSWORD=
PERIAPSIS_WORKER_DATABASE_PASSWORD=
PERIAPSIS_BOOTSTRAP_TOKEN=
PERIAPSIS_MASTER_KEY=
# One-line JSON keyring; see deploy/compose/README.md for the required shape.
PERIAPSIS_API_CREDENTIAL_KEYRING=
# Independent one-line JSON identity keyring shared by API and worker.
PERIAPSIS_IDENTITY_KEYRING=
# Required by preparation, consumed only by the full profile. This connects the dedicated
# periapsis_notifier_login; never reuse the API or worker password.
PERIAPSIS_NOTIFIER_DATABASE_PASSWORD=
# Required by every API profile and the full-profile notifier. Use the same strong
# bearer token (32-512 allowlisted characters) at both ends of the private preview hop.
PERIAPSIS_NOTIFIER_PREVIEW_TOKEN=
# JSON keyring used only to seal notification endpoint credentials. See README.
PERIAPSIS_NOTIFICATION_KEYRING=

# Required by preparation, consumed only by auth-test/full. Local-development only.
PERIAPSIS_LDAP_ADMIN_PASSWORD=
# Required only while running the composed LDAP acceptance. It is passed to the
# one-shot fixture command and is never configured on a long-running service.
PERIAPSIS_LDAP_ACCEPTANCE_USER_PASSWORD=
PERIAPSIS_LDAP_ACCEPTANCE_SECOND_USER_PASSWORD=
PERIAPSIS_LDAP_ACCEPTANCE_CUSTOMER_PASSWORD=
PERIAPSIS_LDAP_ACCEPTANCE_ISOLATION_PASSWORD=
PERIAPSIS_IDP_ADMIN_USERNAME=admin
PERIAPSIS_IDP_ADMIN_PASSWORD=

# Required by every runtime profile. MinIO is a local compatibility target, not
# production storage; root and application credentials must be independent.
PERIAPSIS_MINIO_ROOT_USER=
PERIAPSIS_MINIO_ROOT_PASSWORD=
PERIAPSIS_S3_ACCESS_KEY=
PERIAPSIS_S3_SECRET_KEY=

# Required absolute paths outside the repository. The leaf certificate must have
# SANs for localhost, idp.localhost, storage.localhost, 127.0.0.1, and ::1. Never point the CA
# entry at mkcert's rootCA-key.pem or place any private key in this repository.
PERIAPSIS_DEV_TLS_CERT_FILE=
PERIAPSIS_DEV_TLS_KEY_FILE=
PERIAPSIS_DEV_TLS_CA_FILE=

# Non-secret local overrides.
PERIAPSIS_WEB_PORT=8443
PERIAPSIS_IMAGE_TAG=development
PERIAPSIS_IMAGE_REVISION=local
PERIAPSIS_AUTH_KDF_CONCURRENCY=2
PERIAPSIS_API_RATE_LIMIT_NETWORK_RPS=100
PERIAPSIS_API_RATE_LIMIT_CREDENTIAL_RPS=60
PERIAPSIS_API_RATE_LIMIT_TENANT_SUBJECT_RPS=40
PERIAPSIS_REQUEST_TIMEOUT=15s
PERIAPSIS_AUTH_CLEANUP_BATCH_SIZE=250
PERIAPSIS_AUTH_CLEANUP_INTERVAL=5m
PERIAPSIS_DATABASE_TIMEOUT=5s
PERIAPSIS_WORKER_POLL_INTERVAL=5s
PERIAPSIS_SLA_BATCH_SIZE=10
PERIAPSIS_SLA_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_LEASE_DURATION=2m
PERIAPSIS_SLA_RUN_TIMEOUT=2m
PERIAPSIS_SLA_MAXIMUM_ATTEMPTS=10
PERIAPSIS_SLA_RETRY_BASE_DELAY=15s
PERIAPSIS_SLA_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_SLA_POLL_INTERVAL=2s
PERIAPSIS_SLA_ACTION_BATCH_SIZE=10
PERIAPSIS_SLA_ACTION_LEASE_DURATION=2m
PERIAPSIS_SLA_ACTION_LEASE_SAFETY=15s
PERIAPSIS_SLA_ACTION_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_ACTION_POLL_INTERVAL=2s
PERIAPSIS_SLA_ACTION_QUEUE_LIMIT=100
PERIAPSIS_SLA_ACTION_RUN_TIMEOUT=2m
PERIAPSIS_SLA_EVENT_BATCH_SIZE=10
PERIAPSIS_SLA_EVENT_LEASE_DURATION=2m
PERIAPSIS_SLA_EVENT_MAXIMUM_ATTEMPTS=10
PERIAPSIS_SLA_EVENT_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_EVENT_POLL_INTERVAL=2s
PERIAPSIS_SLA_EVENT_RETRY_BASE_DELAY=15s
PERIAPSIS_SLA_EVENT_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_SLA_EVENT_RUN_TIMEOUT=2m
PERIAPSIS_TICKET_EXPORT_RECONCILE_BATCH_SIZE=25
PERIAPSIS_TICKET_EXPORT_RECONCILE_LEASE_DURATION=2m
PERIAPSIS_TICKET_EXPORT_RECONCILE_LEASE_SAFETY=15s
PERIAPSIS_TICKET_EXPORT_RECONCILE_MAXIMUM_ATTEMPTS=10
PERIAPSIS_TICKET_EXPORT_RECONCILE_OPERATION_TIMEOUT=5s
PERIAPSIS_TICKET_EXPORT_RECONCILE_RETRY_BASE_DELAY=15s
PERIAPSIS_TICKET_EXPORT_RECONCILE_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_DFIR_MAX_OBJECT_BYTES=5000000000
PERIAPSIS_DFIR_PRIVATE_EGRESS_CIDRS=172.30.242.2/32,172.30.242.3/32
PERIAPSIS_DFIR_SCANNER_TIMEOUT=5m
PERIAPSIS_DFIR_SCAN_BATCH_SIZE=4
PERIAPSIS_DFIR_SCAN_LEASE_DURATION=10m
PERIAPSIS_DFIR_SCAN_OPERATION_TIMEOUT=6m
PERIAPSIS_DFIR_SCAN_POLL_INTERVAL=2s
PERIAPSIS_DFIR_SCAN_RETRY_BASE_DELAY=15s
PERIAPSIS_DFIR_SCAN_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_DFIR_SCAN_UPLOAD_POLL_DELAY=5s
PERIAPSIS_DFIR_CLEANUP_BATCH_SIZE=16
PERIAPSIS_DFIR_CLEANUP_DELETE_TIMEOUT=30s
PERIAPSIS_DFIR_CLEANUP_LEASE_DURATION=2m
PERIAPSIS_DFIR_CLEANUP_POLL_INTERVAL=30s
PERIAPSIS_DFIR_CLEANUP_RETRY_BASE_DELAY=10s
PERIAPSIS_S3_MAX_CONCURRENT=16
PERIAPSIS_FEDERATED_PRIVATE_EGRESS_CIDRS=172.30.241.0/28
PERIAPSIS_FEDERATED_HTTPS_PORTS=443,18090
PERIAPSIS_FEDERATED_MAX_CONCURRENT=16
PERIAPSIS_FEDERATED_OIDC_CLOCK_SKEW=1m
PERIAPSIS_FEDERATED_OPERATION_TIMEOUT=20s
PERIAPSIS_FEDERATED_CA_BUNDLE_FILE=/run/secrets/periapsis-dev-tls-ca.crt
PERIAPSIS_OIDC_MAINTENANCE_BATCH_SIZE=12
PERIAPSIS_OIDC_MAINTENANCE_LEASE_SAFETY=5s
PERIAPSIS_OIDC_MAINTENANCE_POLL_INTERVAL=2s
PERIAPSIS_LDAP_PRIVATE_EGRESS_CIDRS=172.30.241.0/28
PERIAPSIS_LDAP_MAX_CONCURRENT=8
PERIAPSIS_LDAP_STARTTLS_PORTS=389
PERIAPSIS_LDAP_LDAPS_PORTS=636
PERIAPSIS_LDAP_SYNC_ABSENCE_BATCH_SIZE=100
PERIAPSIS_LDAP_SYNC_LEASE=30s
PERIAPSIS_LDAP_SYNC_MIN_BACKOFF=1s
PERIAPSIS_LDAP_SYNC_MAX_BACKOFF=30s
PERIAPSIS_LDAP_SYNC_OPERATION_TIMEOUT=30m
PERIAPSIS_LDAP_SYNC_PARALLELISM=2
PERIAPSIS_LOG_LEVEL=info
PERIAPSIS_NOTIFIER_BATCH_SIZE=50
PERIAPSIS_NOTIFIER_BUSY_POLL_MS=25
PERIAPSIS_NOTIFIER_CONCURRENCY=8
PERIAPSIS_NOTIFIER_DELIVERY_TIMEOUT_MS=30000
PERIAPSIS_NOTIFIER_FAILURE_POLL_MS=5000
PERIAPSIS_NOTIFIER_FANOUT_BATCH_SIZE=50
PERIAPSIS_NOTIFIER_FANOUT_CONCURRENCY=8
PERIAPSIS_NOTIFIER_FANOUT_HEARTBEAT_MS=15000
PERIAPSIS_NOTIFIER_FANOUT_INITIAL_RETRY_MS=1000
PERIAPSIS_NOTIFIER_FANOUT_LEASE_MS=60000
PERIAPSIS_NOTIFIER_FANOUT_MAX_RETRY_MS=60000
PERIAPSIS_NOTIFIER_FANOUT_TIMEOUT_MS=30000
PERIAPSIS_NOTIFIER_HEARTBEAT_MS=15000
PERIAPSIS_NOTIFIER_IDLE_POLL_MS=1000
PERIAPSIS_NOTIFIER_LEASE_MS=60000
PERIAPSIS_NOTIFIER_MAX_OUTPUT_BYTES=262144
PERIAPSIS_NOTIFIER_READINESS_TIMEOUT_MS=2000
PERIAPSIS_NOTIFIER_RENDER_TIMEOUT_MS=100
# Development-only notifier egress allowlist. Plain HTTP still requires the
# independent process and database-role opt-ins and an exact loopback host.
PERIAPSIS_WEBHOOK_ALLOWED_PORTS=80,443,8080

# TLS edge and auxiliary host bindings are loopback-only. The three edge ports
# must remain unprivileged (1024-65535); each value is both host and listener port.
PERIAPSIS_IDP_PORT=18090
PERIAPSIS_MAILPIT_PORT=18025
PERIAPSIS_MAILPIT_SMTP_PORT=11025
PERIAPSIS_MINIO_API_PORT=19000
PERIAPSIS_MINIO_CONSOLE_PORT=19001
PERIAPSIS_PROMETHEUS_PORT=19090

# The notifier is referenced rather than built until its runtime image is published.
PERIAPSIS_NOTIFIER_IMAGE=periapsis/notifier:development
