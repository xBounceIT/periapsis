ARG NODE_IMAGE=node:24.20.0-alpine3.23@sha256:0388af2af070cd4736a1567cfed02469ba117848845b4165d87a333edb53d2ca

FROM ${NODE_IMAGE} AS build

RUN apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json

RUN corepack pnpm install --frozen-lockfile --filter @periapsis/db...

COPY packages/db/ packages/db/
COPY packages/tsconfig/ packages/tsconfig/
COPY deploy/compose/database-task-config.mjs deploy/compose/database-task-config.mjs
COPY deploy/compose/database-task.mjs deploy/compose/database-task.mjs

RUN corepack pnpm --filter @periapsis/db build:runtime \
    && corepack pnpm --filter @periapsis/db deploy --legacy --prod --config.hoist-workspace-packages=false /out \
    && test -f packages/db/dist/src/admin/migrate.js \
    && test -f packages/db/dist/seeds/seed.js \
    && node --check deploy/compose/database-task-config.mjs \
    && node --check deploy/compose/database-task.mjs

FROM ${NODE_IMAGE}

ARG REVISION=unknown
ARG VERSION=development

LABEL org.opencontainers.image.description="Periapsis one-shot database migration and seed runner" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.source="https://github.com/periapsis-im/periapsis" \
      org.opencontainers.image.title="Periapsis Database Runner" \
      org.opencontainers.image.version=$VERSION

RUN apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
    && addgroup -S -g 10001 periapsis \
    && adduser -S -D -H -u 10001 -G periapsis periapsis \
    && install -d -o 10001 -g 10001 -m 1770 /workspace /tmp

# Only compiled task code, immutable data, and production dependencies cross stages.
# Keep the source-relative layout used by the migration and SLA fixture loaders.
COPY --from=build --chown=10001:10001 /out/package.json /workspace/packages/db/package.json
COPY --from=build --chown=10001:10001 /out/node_modules /workspace/packages/db/node_modules
COPY --from=build --chown=10001:10001 /workspace/packages/db/dist/ /workspace/packages/db/
COPY --from=build --chown=10001:10001 /workspace/packages/db/migrations/ /workspace/packages/db/migrations/
COPY --from=build --chown=10001:10001 /workspace/packages/db/seeds/sla-fixture.generated.json /workspace/packages/db/seeds/sla-fixture.generated.json
COPY --from=build --chown=10001:10001 /workspace/deploy/compose/database-task-config.mjs /workspace/deploy/compose/database-task-config.mjs
COPY --from=build --chown=10001:10001 /workspace/deploy/compose/database-task.mjs /workspace/deploy/compose/database-task.mjs

RUN rm -rf /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/npm \
      /etc/apk /var/cache/apk \
    && rm -f /usr/local/bin/corepack /usr/local/bin/npm /usr/local/bin/npx \
      /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
      /sbin/apk /usr/bin/apk

ENV HOME=/tmp \
    NODE_ENV=production \
    TMPDIR=/tmp

WORKDIR /workspace
USER 10001:10001
STOPSIGNAL SIGTERM

ENTRYPOINT ["node", "deploy/compose/database-task.mjs"]
CMD ["migrate"]
