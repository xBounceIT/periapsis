ARG NODE_IMAGE=node:24.20.0-alpine3.23@sha256:0388af2af070cd4736a1567cfed02469ba117848845b4165d87a333edb53d2ca

# TypeScript and the production dependency tree are architecture-independent.
# Run the build tools natively; the final Node image follows the target platform.
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS build

# The pinned Node base predates Alpine's OpenSSL 3.5.8 security package.
RUN apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0

ENV CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/notifier/package.json services/notifier/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json

RUN corepack pnpm install --frozen-lockfile --filter @periapsis/notifier...

COPY services/notifier/ services/notifier/
COPY packages/tsconfig/ packages/tsconfig/
COPY deploy/compose/portable-database-artifact.mjs deploy/compose/portable-notifier-artifact.mjs deploy/compose/

RUN corepack pnpm --filter @periapsis/notifier build \
    && corepack pnpm --filter @periapsis/notifier deploy --legacy --prod --config.hoist-workspace-packages=false /out \
    && node deploy/compose/portable-notifier-artifact.mjs /out \
    && test -f /out/dist/main.js

FROM ${NODE_IMAGE}

ARG REVISION=unknown
ARG VERSION=development

LABEL org.opencontainers.image.description="Periapsis notification outbox consumer and preview service" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.source="https://github.com/periapsis-im/periapsis" \
      org.opencontainers.image.title="Periapsis Notifier" \
      org.opencontainers.image.version=$VERSION

RUN apk add --no-cache --upgrade libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
    && addgroup -S -g 10001 periapsis \
    && adduser -S -D -H -u 10001 -G periapsis periapsis \
    && install -d -o 10001 -g 10001 -m 1770 /app /tmp

WORKDIR /app
COPY --from=build --chown=10001:10001 /out/package.json ./package.json
COPY --from=build --chown=10001:10001 /out/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /out/dist ./dist

RUN rm -rf /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/npm \
      /etc/apk /var/cache/apk \
    && rm -f /usr/local/bin/corepack /usr/local/bin/npm /usr/local/bin/npx \
      /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
      /sbin/apk /usr/bin/apk

ENV HOME=/tmp \
    NODE_ENV=production \
    TMPDIR=/tmp

USER 10001:10001
EXPOSE 8083
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8083/health/ready',{signal:AbortSignal.timeout(2000)}).then(response=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]

ENTRYPOINT ["node", "dist/main.js"]
