# Copy to .env for local development. Never commit real credentials.
PERIAPSIS_ENV=development
PERIAPSIS_LOG_LEVEL=info
# Telemetry is an explicit choice. Local direct processes default to disabled;
# Compose supplies false plus the exact per-process service name and collector.
OTEL_SDK_DISABLED=true
PERIAPSIS_API_ADDR=:8080
PERIAPSIS_WEB_ADDR=:8081
# Browser traffic enters through the Compose TLS edge; application hops stay
# HTTP-only on their isolated Docker networks.
PERIAPSIS_WEB_PORT=8443
PERIAPSIS_IDP_PORT=18090
PERIAPSIS_MINIO_API_PORT=19000
PERIAPSIS_PUBLIC_URL=https://localhost:8443
# Optional HTTP origin behind a remote trusted HTTPS proxy. The dedicated
# compose.reverse-proxy.yaml / stack.reverse-proxy.yml variants enable this flag;
# see their env examples for explicit CIDRs, public origin and listener ports.
PERIAPSIS_WEB_PROXY_ONLY=false
# External local-development TLS material. Generate these outside the repository
# with SANs for localhost, idp.localhost, storage.localhost, 127.0.0.1, and ::1.
PERIAPSIS_DEV_TLS_CERT_FILE=
PERIAPSIS_DEV_TLS_KEY_FILE=
PERIAPSIS_DEV_TLS_CA_FILE=
# Bounds concurrent memory-hard Argon2 operations per API replica.
PERIAPSIS_AUTH_KDF_CONCURRENCY=2
# Shared PostgreSQL one-second API budgets. Each value must be 1..100; the
# credential and bounded tenant-subject limits supplement the client-network limit.
PERIAPSIS_API_RATE_LIMIT_NETWORK_RPS=100
PERIAPSIS_API_RATE_LIMIT_CREDENTIAL_RPS=60
PERIAPSIS_API_RATE_LIMIT_TENANT_SUBJECT_RPS=40
# Must remain below the API server write timeout.
PERIAPSIS_REQUEST_TIMEOUT=15s
# Worker maintenance is bounded independently per authentication/admission class. Database
# work is cancelled at the same timeout used for PostgreSQL statement_timeout.
PERIAPSIS_AUTH_CLEANUP_BATCH_SIZE=250
PERIAPSIS_AUTH_CLEANUP_INTERVAL=5m
PERIAPSIS_DATABASE_TIMEOUT=5s
PERIAPSIS_WORKER_POLL_INTERVAL=5s
# SLA work is claimed with a fencing lease. The lease and per-run timeout must
# cover one full sequential batch at the configured operation timeout.
PERIAPSIS_SLA_BATCH_SIZE=10
PERIAPSIS_SLA_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_LEASE_DURATION=2m
PERIAPSIS_SLA_RUN_TIMEOUT=2m
PERIAPSIS_SLA_MAXIMUM_ATTEMPTS=10
PERIAPSIS_SLA_RETRY_BASE_DELAY=15s
PERIAPSIS_SLA_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_SLA_POLL_INTERVAL=2s
# Trigger side effects are a separate fenced runtime. Its readiness and queue
# limits are independent from SLA evaluation so a failed action sink closes
# worker readiness without silently stopping new breach evaluation.
PERIAPSIS_SLA_ACTION_BATCH_SIZE=10
PERIAPSIS_SLA_ACTION_LEASE_DURATION=2m
PERIAPSIS_SLA_ACTION_LEASE_SAFETY=15s
PERIAPSIS_SLA_ACTION_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_ACTION_POLL_INTERVAL=2s
PERIAPSIS_SLA_ACTION_QUEUE_LIMIT=100
PERIAPSIS_SLA_ACTION_RUN_TIMEOUT=2m
# Ticket mutation outbox events are ingested through their own ordered,
# fenced stream. These settings bound source attestation, planning, commit,
# retry, and dead-letter handling independently from timer evaluation.
PERIAPSIS_SLA_EVENT_BATCH_SIZE=10
PERIAPSIS_SLA_EVENT_LEASE_DURATION=2m
PERIAPSIS_SLA_EVENT_MAXIMUM_ATTEMPTS=10
PERIAPSIS_SLA_EVENT_OPERATION_TIMEOUT=5s
PERIAPSIS_SLA_EVENT_POLL_INTERVAL=2s
PERIAPSIS_SLA_EVENT_RETRY_BASE_DELAY=15s
PERIAPSIS_SLA_EVENT_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_SLA_EVENT_RUN_TIMEOUT=2m
# Expired and orphaned export objects are reclaimed only through an exact
# database fence plus manifest/checksum/ETag verification; bucket listing is
# never part of the protocol.
PERIAPSIS_TICKET_EXPORT_RECONCILE_BATCH_SIZE=25
PERIAPSIS_TICKET_EXPORT_RECONCILE_LEASE_DURATION=2m
PERIAPSIS_TICKET_EXPORT_RECONCILE_LEASE_SAFETY=15s
PERIAPSIS_TICKET_EXPORT_RECONCILE_MAXIMUM_ATTEMPTS=10
PERIAPSIS_TICKET_EXPORT_RECONCILE_OPERATION_TIMEOUT=5s
PERIAPSIS_TICKET_EXPORT_RECONCILE_RETRY_BASE_DELAY=15s
PERIAPSIS_TICKET_EXPORT_RECONCILE_RETRY_MAXIMUM_DELAY=15m
# Empty trusts no forwarded client address. Compose sets this to the exact web
# service address; production ingress must use its own narrowly scoped CIDRs.
PERIAPSIS_TRUSTED_PROXY_CIDRS=
# The web proxy independently resolves and sanitizes the incoming chain before
# forwarding one canonical address to the API. Empty trusts no upstream proxy.
PERIAPSIS_WEB_TRUSTED_PROXY_CIDRS=
# Local Compose secrets. Generate independent high-entropy values before startup.
PERIAPSIS_POSTGRES_PASSWORD=change-me-postgres
PERIAPSIS_API_DATABASE_PASSWORD=change-me-api
PERIAPSIS_WORKER_DATABASE_PASSWORD=change-me-worker
PERIAPSIS_NOTIFIER_DATABASE_PASSWORD=change-me-notifier
PERIAPSIS_AUDITOR_DATABASE_PASSWORD=change-me-auditor
# Local Compose reads these values into read-only secret files. The bootstrap
# token must be independent and high entropy; the master key must be standard
# padded Base64 encoding of exactly 32 random bytes.
PERIAPSIS_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-bytes
PERIAPSIS_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes
# One-line JSON. Each key is independent standard padded Base64 for 32 random
# bytes; activeVersion selects issuance while older live versions remain listed.
PERIAPSIS_API_CREDENTIAL_KEYRING={"activeVersion":1,"keys":[{"version":1,"key":"replace-with-base64-of-exactly-32-random-bytes"}]}
# Separate identity-provider roots. Active and retained versions must be
# identical on every API/worker replica during a rolling deployment.
PERIAPSIS_IDENTITY_KEYRING={"activeVersion":1,"keys":[{"version":1,"key":"replace-with-an-independent-base64-32-byte-random-key"}]}
# Federated discovery, JWKS, metadata, token, and UserInfo traffic is HTTPS-only.
# Empty private CIDRs permit only public destinations; non-default ports must be
# explicitly allowlisted by the deployment and are rechecked after every DNS lookup.
PERIAPSIS_FEDERATED_PRIVATE_EGRESS_CIDRS=
PERIAPSIS_FEDERATED_HTTPS_PORTS=443,18090
PERIAPSIS_FEDERATED_MAX_CONCURRENT=16
PERIAPSIS_FEDERATED_OIDC_CLOCK_SKEW=1m
PERIAPSIS_FEDERATED_OPERATION_TIMEOUT=20s
# Optional deployment-mounted PEM appended to the system trust store.
PERIAPSIS_FEDERATED_CA_BUNDLE_FILE=
PERIAPSIS_OIDC_MAINTENANCE_BATCH_SIZE=12
PERIAPSIS_OIDC_MAINTENANCE_LEASE_SAFETY=5s
PERIAPSIS_OIDC_MAINTENANCE_POLL_INTERVAL=2s
# Shared only through mounted secret files at runtime. Generate an independent
# 32+ byte preview bearer and base64url-without-padding 32-byte keyring roots.
PERIAPSIS_NOTIFIER_PREVIEW_TOKEN=replace-with-at-least-32-independent-random-bytes
PERIAPSIS_NOTIFICATION_KEYRING={"activeVersion":1,"keys":[{"version":1,"key":"replace-with-base64url-without-padding-of-exactly-32-random-bytes"}]}
# Tenant LDAP may reach private enterprise ranges only when the deployment
# explicitly lists them. Empty blocks every private destination.
PERIAPSIS_LDAP_PRIVATE_EGRESS_CIDRS=
PERIAPSIS_LDAP_MAX_CONCURRENT=8
PERIAPSIS_LDAP_STARTTLS_PORTS=389
PERIAPSIS_LDAP_LDAPS_PORTS=636
PERIAPSIS_DATABASE_URL=postgres://periapsis_api_login:change-me-api@postgres:5432/periapsis?sslmode=disable
# PERIAPSIS_DATABASE_URL_FILE=/run/secrets/api_database_url
PERIAPSIS_MIGRATION_DATABASE_URL=postgres://postgres:change-me-postgres@postgres:5432/periapsis?sslmode=disable
# PERIAPSIS_API_DATABASE_PASSWORD_FILE=/run/secrets/api_database_password
# PERIAPSIS_WORKER_DATABASE_PASSWORD_FILE=/run/secrets/worker_database_password
# PERIAPSIS_NOTIFIER_DATABASE_PASSWORD_FILE=/run/secrets/notifier_database_password
# PERIAPSIS_AUDITOR_DATABASE_PASSWORD_FILE=/run/secrets/auditor_database_password
PERIAPSIS_BOOTSTRAP_TOKEN_FILE=/run/secrets/periapsis_bootstrap_token
PERIAPSIS_MASTER_KEY_FILE=/run/secrets/periapsis_master_key
PERIAPSIS_API_CREDENTIAL_KEYRING_FILE=/run/secrets/periapsis_api_credential_keyring
PERIAPSIS_IDENTITY_KEYRING_FILE=/run/secrets/periapsis_identity_keyring
PERIAPSIS_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
PERIAPSIS_S3_ENDPOINT=http://minio:9000
PERIAPSIS_S3_PUBLIC_ENDPOINT=https://storage.localhost:19000
PERIAPSIS_S3_REGION=us-east-1
PERIAPSIS_S3_BUCKET=periapsis-evidence
PERIAPSIS_S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
PERIAPSIS_S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
# Plaintext is development-only. The immutable endpoint is still resolved and
# checked against this explicit private egress range before every new dial.
PERIAPSIS_S3_ALLOW_PLAINTEXT_LOCAL=true
PERIAPSIS_S3_MAX_CONCURRENT=16
PERIAPSIS_DFIR_PRIVATE_EGRESS_CIDRS=172.16.0.0/12
# Single PutObject is deliberately capped at 5 GB decimal. Larger uploads need
# the future multipart ceremony and are rejected before presigning.
PERIAPSIS_DFIR_MAX_OBJECT_BYTES=5000000000
PERIAPSIS_DFIR_SCANNER_ENDPOINT=tcp://clamav:3310
PERIAPSIS_DFIR_SCANNER_ALLOW_PLAINTEXT_LOCAL=true
PERIAPSIS_DFIR_SCANNER_TIMEOUT=5m
PERIAPSIS_DFIR_SCAN_BATCH_SIZE=4
PERIAPSIS_DFIR_SCAN_LEASE_DURATION=10m
PERIAPSIS_DFIR_SCAN_OPERATION_TIMEOUT=6m
PERIAPSIS_DFIR_SCAN_POLL_INTERVAL=2s
PERIAPSIS_DFIR_SCAN_RETRY_BASE_DELAY=15s
PERIAPSIS_DFIR_SCAN_RETRY_MAXIMUM_DELAY=15m
PERIAPSIS_DFIR_SCAN_UPLOAD_POLL_DELAY=5s
PERIAPSIS_DFIR_CLEANUP_BATCH_SIZE=16
PERIAPSIS_DFIR_CLEANUP_DELETE_TIMEOUT=30s
PERIAPSIS_DFIR_CLEANUP_LEASE_DURATION=2m
PERIAPSIS_DFIR_CLEANUP_POLL_INTERVAL=30s
PERIAPSIS_DFIR_CLEANUP_RETRY_BASE_DELAY=10s
# Non-secret global worker principal installed by the canonical local migration.
PERIAPSIS_TICKET_RUNTIME_SERVICE_ACCOUNT_ID=01890f00-0000-7000-8000-0000000000f1
PERIAPSIS_SMTP_HOST=mailpit
PERIAPSIS_SMTP_PORT=1025
PERIAPSIS_SMTP_FROM=periapsis@example.invalid
# Compose overrides this only for the isolated Mailpit development network.
PERIAPSIS_SMTP_ALLOW_PLAIN_LOCAL=false
# Development-only double consent for webhook URLs. `true` is accepted only by
# non-production API/notifier processes and by the privileged database task,
# which records opt-in for the exact runtime login. Both controls must be true
# for exact localhost, 127.0.0.1, or ::1 HTTP URLs; production rejects `true`.
PERIAPSIS_WEBHOOK_ALLOW_PLAIN_LOCAL=false
